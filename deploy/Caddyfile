http://www.th37.ru, https://www.th37.ru {
	redir https://th37.ru{uri} permanent
}

th37.ru {
	@office path /crm /crm/* /admin /admin/*
	respond @office 404
	encode zstd gzip
	reverse_proxy production:8000
}

admin.th37.ru {
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	redir / /crm/ 302
	redir /crm /crm/ 302
	@office path /crm/* /admin/* /static/* /favicon.ico
	handle @office {
		reverse_proxy production:8000
	}
	handle {
		respond 404
	}
}

staging.th37.ru {
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		import /etc/caddy/staging-users
	}
	@office path /crm /crm/* /admin /admin/*
	respond @office 404
	encode zstd gzip
	reverse_proxy staging:8000
}
